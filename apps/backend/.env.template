# Database — Railway auto-populates ${{Postgres.DATABASE_URL}} in deployed envs
DATABASE_URL=

# Redis — Railway auto-populates ${{Redis.REDIS_URL}} in deployed envs
REDIS_URL=redis://localhost:6379

# CORS — set to your actual storefront and admin URLs
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=

# Node environment
NODE_ENV=development

# ONVO Pay — get keys from dashboard.onvopay.com
ONVO_SECRET_KEY=           # onvo_test_secret_key_... / onvo_live_secret_key_...
ONVO_PUBLISHABLE_KEY=      # onvo_test_publishable_key_... (used by storefront JS)
ONVO_WEBHOOK_SECRET=       # webhook_secret_... from ONVO dashboard → Developers

# Storefront hostname — used to validate 3DS return URLs
STOREFRONT_HOST=localhost  # e.g. mystore.com in production
