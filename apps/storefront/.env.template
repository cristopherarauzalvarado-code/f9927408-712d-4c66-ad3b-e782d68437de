# Publishable API key for the Medusa backend.
# Retrieve from admin → Settings → Publishable API Keys after seeding.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code (cr = Costa Rica)
NEXT_PUBLIC_DEFAULT_REGION=cr

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# ONVO Pay publishable key — get from dashboard.onvopay.com → Developers
NEXT_PUBLIC_ONVO_PUBLISHABLE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# --- Branding (personalización por cliente, ver src/lib/site-config.ts) ---
# Nombre de la tienda (logo, metadatos). Default: SHOP.CO
NEXT_PUBLIC_STORE_NAME=
# Descripción corta usada en el footer
NEXT_PUBLIC_STORE_DESCRIPTION=
# Color primario de marca (botones, badges, barra de anuncio). Default: #000000
NEXT_PUBLIC_BRAND_PRIMARY=
# Color del texto sobre el primario. Default: #FFFFFF
NEXT_PUBLIC_BRAND_PRIMARY_FG=

# --- Atención al cliente (página /customer-service) ---
# Correo de soporte mostrado en la página de atención al cliente
NEXT_PUBLIC_SUPPORT_EMAIL=
# Teléfono de soporte
NEXT_PUBLIC_SUPPORT_PHONE=
# WhatsApp (solo dígitos, ej. 50600000000). Si se deja vacío, no se muestra la tarjeta.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Endpoint del proveedor de newsletter (Mailchimp/Brevo/Zapier/webhook propio).
# Recibe un POST { email }. Si se deja vacío, la suscripción funciona pero solo
# se registra en logs (no se pierde el flujo en dev).
NEWSLETTER_WEBHOOK_URL=

# Node environment
NODE_ENV=development
